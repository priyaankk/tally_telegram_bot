# Copy to .env and fill in. Never share or commit .env.

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# From @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids allowed to use the bot. Send /start to the bot to see yours.
ALLOWED_TELEGRAM_USER_IDS=

# Rates: a Google Sheet shared (Editor) with the service account in config/google-service-account.json.
# Leave RATES_SHEET_URL empty to use the local CSV in RATES_CSV instead.
RATES_SHEET_URL=
# GOOGLE_SERVICE_ACCOUNT_FILE=config/google-service-account.json
# RATES_CSV=sheets/rates.csv

# Weekly Tally file: day (Monday=0 … Saturday=5) and local time.
# BATCH_WEEKDAY=5
# BATCH_TIME=21:00
# TIMEZONE=Asia/Kolkata

# Reading model (OpenRouter)
# LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_PROVIDER=coreweave/fp8          # "" lets OpenRouter pick the provider
# LLM_REASONING_EFFORT=high
